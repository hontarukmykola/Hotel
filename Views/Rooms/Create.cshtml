@using hotel.Entities;
@model HotelRoom
<h1>Create Product Form</h1>

<form class="row g-3" method="post" asp-action="Create">
    <div class="col-md-6">
        <label asp-for=Number class="form-label">Number</label>
        <input asp-for=Number type="text" class="form-control" placeholder="Enter Number">
    </div>
    <div class="col-md-6">
        <label asp-for=Rating class="form-label"> Rating </label>
        <input asp-for=Rating type="number" class="form-control" placeholder="Enter Rating">
    </div>
    <div class="col-md-6">
        <label asp-for=Flour class="form-label">Flour</label>
        <input asp-for=Flour type="number" class="form-control" placeholder="Enter Flour">
    </div>
    <div class="col-md-6">
        <label asp-for=AmoundOfPeople class="form-label">Amound Of People</label>
        <input asp-for=AmoundOfPeople type="number" class="form-control" placeholder="Enter Amound Of People">
    </div>
    <div class="col-md-6">
        <label asp-for=AmoundOfBed class="form-label">Amound Of Bed</label>
        <input asp-for=AmoundOfBed type="number" class="form-control" placeholder="Enter Amound Of Bed">
    </div>
    <div class="col-md-6">
        <label asp-for=Price class="form-label">Price</label>
        <input asp-for=Price type="number" class="form-control" placeholder="Enter Price">
    </div>
    <div class="col-md-6">
        <label asp-for=Discount class="form-label">Discount</label>
        <input asp-for=Discount type="number" class="form-control" placeholder="Enter Discount">
    </div>
    @* <div class="col-md-4">
    <label for="inputState" class="form-label">Category</label>
    <select id="inputState" class="form-select">
    <option selected>Choose...</option>
    <option>...</option>
    </select>
    </div> *@

    <div class="col-md-6">
        <button type="button" class="btn btn-dark w-100">Back</button>
    </div>
    <div class="col-md-6">
        <button type="submit" class="btn btn-success w-100">Create</button>
    </div>
</form>