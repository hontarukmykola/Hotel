@using hotel.Dtos
@model HotelRoomsDto

<div class="text-center">
    <h1>Room Number: @Model.Number</h1>

    <p>Rating: @Model.Rating</p>

    <p>Price: @Model.Price$</p>

    <a asp-controller="Cart"
       asp-action="Add"
       asp-route-id="@Model.Id"
       asp-route-returnUrl="@Context.Request.Path"
       class="btn btn-primary">
        Add to Cart
    </a>
</div>




