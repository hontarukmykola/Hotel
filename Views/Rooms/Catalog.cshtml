@using hotel.Entities
@model List<HotelRoom>
<td>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-plus-lg"></i>
        Add New Product
    </a>
</td>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">№</th>
            <th scope="col">Rating</th>
            <th scope="col">Flour</th>
            <th scope="col">Amound of people</th>
            <th scope="col">Amound of bed</th>
            <th scope="col">Price/24h</th>
            <th scope="col">Discount</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Number</td>
                <td>@item.Rating</td>
                <td>@item.Flour</td>
                <td>@item.AmoundOfPeople</td>
                <td>@item.AmoundOfBed</td>
                <td>@item.Price</td>
                <td>@item.Discount</td>
               <td>
                    <a class="btn btn-outline-secondary" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.Id">
                        <i class="bi bi-info-square-fill"></i>
                    </a>
                    <a class="btn btn-outline-warning" asp-controller="Rooms" asp-action="Edit" asp-route-id="@item.Id">
                        <i class="bi bi-pencil-fill"></i>
                    </a>
                    <a class="btn btn-outline-danger" asp-controller="Rooms" asp-action="Delete" asp-route-id="@item.Id">
                        <i class="bi bi-trash-fill"></i>
                    </a>
                </td>

            
            </tr>
        }
    </tbody>
</table>
                 
